{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentforge.local/week2/schemas/lab_pdf.schema.json",
  "title": "AgentForge Week 2 Lab PDF Extraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_type",
    "schema_version",
    "patient_id",
    "source_document",
    "extraction",
    "lab_results"
  ],
  "properties": {
    "doc_type": {
      "type": "string",
      "const": "lab_pdf"
    },
    "schema_version": {
      "type": "string",
      "const": "week2.lab_pdf.v1"
    },
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_id",
        "filename",
        "page_count"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "const": "openemr_document"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "extracted_at",
        "confidence"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "lab_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_name",
          "value",
          "unit",
          "reference_range",
          "collection_date",
          "abnormal_flag",
          "source_citation"
        ],
        "properties": {
          "test_name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "reference_range": {
            "type": "string",
            "minLength": 1
          },
          "collection_date": {
            "type": "string",
            "format": "date"
          },
          "abnormal_flag": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "critical",
              "unknown"
            ]
          },
          "source_citation": {
            "$ref": "citation.schema.json"
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
